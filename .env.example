# =============================================================================
# ★ AI 模型 API 配置
# =============================================================================
# DeepSeek API Key
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=

# 智谱 AI 搜索 API（仅用于联网搜索）
ZHIPU_API_KEY=


# =============================================================================
# ★ 主模型 & 代码托管平台配置
# =============================================================================

# 默认使用的主模型名称，对应 LangChain ChatModel 的 model 参数。
MAIN_MODEL=deepseek-v4-pro

# 用户意图分类模型；留空时跟随 MAIN_MODEL。
INTENT_MODEL=
INTENT_MODEL_TEMPERATURE=0
INTENT_MODEL_MAX_TOKENS=200

# GitHub 代码托管平台访问令牌和 API 地址
# 请只在本机填写 Token，切勿提交或粘贴到日志、截图和聊天中。
GITHUB_TOKEN=
GITHUB_API_BASE_URL=

# =============================================================================
# ★ 操作系统与多平台路径配置
# =============================================================================
# 使用说明：
# 1. LOCAL_SHELL_PLATFORM 推荐填写 auto，也支持 macos 或 windows；
# 2. env_utils.py 会读取对应的 *_MACOS / *_WINDOWS，并映射为代码使用的通用变量；
# 3. Windows 路径推荐统一使用 /，避免反斜杠转义问题；
# 4. 修改平台或路径后需要重启后端服务。

# Agent 工作区是本地 Shell 的安全边界，只允许操作该目录下的仓库文件。
LOCAL_SHELL_PLATFORM=auto

# 通用路径：适合只在一台机器上运行时直接配置。
# 如果同一份 .env 要在 macOS 和 Windows 共用，可留空并使用下方平台专用值。
AI_WORKSPACE_ROOT=
LOCAL_SHELL_WORKSPACE=
LQ_AICODING_DATA_DIR=
CHECKPOINT_DB_PATH=
STORE_DB_PATH=
LANGGRAPH_STORE_DB_PATH=
LQ_AICODING_LOG_DIR=

# =============================================================================
# macOS 路径配置
# =============================================================================
# Agent 工作区与 LocalShell 执行目录
AI_WORKSPACE_ROOT_MACOS=
LOCAL_SHELL_WORKSPACE_MACOS=

# SQLite 数据目录与数据库文件
# 对应 settings.py 中的 DATA_DIR 和三个 SQLite 数据库路径。
LQ_AICODING_DATA_DIR_MACOS=
CHECKPOINT_DB_PATH_MACOS=
STORE_DB_PATH_MACOS=
LANGGRAPH_STORE_DB_PATH_MACOS=

# 后端日志目录
LQ_AICODING_LOG_DIR_MACOS=

# =============================================================================
# Windows 路径配置
# =============================================================================
# Windows 配置统一使用正斜杠，避免 .env 中反斜杠转义问题。
# Agent 工作区与 LocalShell 执行目录
AI_WORKSPACE_ROOT_WINDOWS=
LOCAL_SHELL_WORKSPACE_WINDOWS=

# SQLite 数据目录与数据库文件
# 对应 settings.py 中的 DATA_DIR 和三个 SQLite 数据库路径。
LQ_AICODING_DATA_DIR_WINDOWS=
CHECKPOINT_DB_PATH_WINDOWS=
STORE_DB_PATH_WINDOWS=
LANGGRAPH_STORE_DB_PATH_WINDOWS=

# 后端日志目录
LQ_AICODING_LOG_DIR_WINDOWS=

# =============================================================================
# ★ 日志配置
# =============================================================================
# 日志目录由上方当前平台的 LQ_AICODING_LOG_DIR_* 决定。
# 对应 settings.py 中的 LOG_DIR / LOG_LEVEL / LOG_ROTATION_* / LOG_RETENTION_DAYS。

# 当前日志为 backend.log / agent-runs.log，轮转文件使用 .YYYY-MM-DD 后缀。
LQ_AICODING_LOG_LEVEL=
LQ_AICODING_LOG_RETENTION_DAYS=
LQ_AICODING_LOG_WHEN=
LQ_AICODING_LOG_INTERVAL=

# =============================================================================
# ★ Agent 运行保护阈值
# =============================================================================
# 复杂 coding 任务需要给代码修改、测试和 Git/PR 收尾预留足够工具调用额度。
# 对应 settings.py 中 Agent 生命周期限制。

AGENT_MAX_TOOL_CALLS=
AGENT_MAX_SECONDS=
AGENT_CODING_MAX_TOOL_CALLS=
AGENT_CODING_MAX_SECONDS=
AGENT_ANALYSIS_MAX_TOOL_CALLS=
AGENT_ANALYSIS_MAX_SECONDS=
AGENT_PLANNING_MAX_TOOL_CALLS=
AGENT_PLANNING_MAX_SECONDS=
AGENT_REVIEW_MAX_TOOL_CALLS=
AGENT_REVIEW_MAX_SECONDS=
AGENT_QA_MAX_TOOL_CALLS=
AGENT_QA_MAX_SECONDS=
AGENT_INSPECT_MAX_TOOL_CALLS=
AGENT_INSPECT_MAX_SECONDS=
AGENT_SYNC_MAX_TOOL_CALLS=
AGENT_SYNC_MAX_SECONDS=

# =============================================================================
# ★ LangSmith 追踪
# =============================================================================
# LangSmith 追踪配置（默认关闭）
LANGCHAIN_TRACING_V2=false
LANGSMITH_TRACING=false
LANGCHAIN_API_KEY=

# =============================================================================
# ★ Dashboard（前端面板）配置
# =============================================================================

DASHBOARD_ALLOWED_ORIGINS=

# =============================================================================
# ★ 沙箱（Sandbox）配置
# =============================================================================
# 当前唯一生效的实现是 LocalShellBackend：直接在本机受控工作区执行命令。
# 它不依赖 localhost、SANDBOX_DOMAIN 或独立的 OpenSandbox 服务。
# macOS 使用 /bin/sh，Windows 使用 cmd.exe；工作区路径由上方平台配置决定。

SANDBOX_TYPE=local_shell
# 共享 venv 路径相对于 LOCAL_SHELL_WORKSPACE，不是相对于当前项目目录。
LOCAL_SHELL_SHARED_PYTHON_VENV=
LOCAL_SHELL_CREATE_PYTHON_VENV=false
LOCAL_SHELL_ENABLE_COMMAND_GUARD=true
# 子进程输出编码：留空时自动使用系统编码（Windows 本地代码页 / macOS UTF-8）。
LOCAL_SHELL_OUTPUT_ENCODING=

# 设为 1 时记录原始流式事件，仅建议排障时临时启用。
LQ_AICODING_DEBUG_STREAM_EVENTS=0
