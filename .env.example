# =============================================================================
# 操作系统与多端路径
# =============================================================================
# 只需切换此开关；env_utils.py 会自动选择对应后缀的路径配置。
# 支持 mac / windows（也兼容 window），修改后需要重启服务。
APP_PLATFORM=mac

# 请按本机实际目录修改。Windows 绝对路径推荐使用 /，可避免反斜杠转义问题。
AI_WORKSPACE_ROOT_MAC=/Users/your-name/ai_workspace
AI_WORKSPACE_ROOT_WINDOWS=C:/Users/your-name/ai_workspace
LQ_AICODING_DATA_DIR_MAC=/Users/your-name/LQ_AICoding/data
LQ_AICODING_DATA_DIR_WINDOWS=C:/Users/your-name/LQ_AICoding/data
CHECKPOINT_DB_PATH_MAC=/Users/your-name/LQ_AICoding/data/checkpoints.sqlite
CHECKPOINT_DB_PATH_WINDOWS=C:/Users/your-name/LQ_AICoding/data/checkpoints.sqlite
STORE_DB_PATH_MAC=/Users/your-name/LQ_AICoding/data/store.sqlite
STORE_DB_PATH_WINDOWS=C:/Users/your-name/LQ_AICoding/data/store.sqlite
LQ_AICODING_LOG_DIR_MAC=/Users/your-name/LQ_AICoding/logs
LQ_AICODING_LOG_DIR_WINDOWS=C:/Users/your-name/LQ_AICoding/logs
LOCAL_SHELL_WORKSPACE_MAC=/Users/your-name/ai_workspace
LOCAL_SHELL_WORKSPACE_WINDOWS=C:/Users/your-name/ai_workspace
# 以下共享 venv 路径相对于 LOCAL_SHELL_WORKSPACE。
LOCAL_SHELL_SHARED_PYTHON_VENV_MAC=runtimes/python/default/.venv
LOCAL_SHELL_SHARED_PYTHON_VENV_WINDOWS=runtimes\python\default\.venv
# 命令守卫建议保持开启；输出编码留空时自动使用当前系统编码。
LOCAL_SHELL_ENABLE_COMMAND_GUARD=true
LOCAL_SHELL_OUTPUT_ENCODING=

# =============================================================================
# AI 模型（必填）
# =============================================================================
GLM_API_KEY=
GLM_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
QWEN_API_KEY=
QWEN_BASE_URL=

# 智谱搜索（不配置时 web_search 工具不可用）
ZHIPU_API_KEY=

# GitHub 代码托管平台
# Token 只填写在本机 .env 中，不要提交到版本库。
GITHUB_TOKEN=
GITHUB_API_BASE_URL=https://api.github.com
GITHUB_WEB_BASE_URL=https://github.com
DEFAULT_REPO_PROVIDER=github

# MongoDB
MONGODB_URI=mongodb://root:root@localhost:27017/?authSource=admin
MONGODB_DB_NAME=langchain_db
MONGODB_CHECKPOINT_COLLECTION=checkpoints

# OpenSandbox
SANDBOX_DOMAIN=http://localhost:8081
OPENSANDBOX_API_KEY=
# 开启后服务启动时会创建一个预热沙箱；本地开发建议关闭。
PREWARM_SANDBOX=false
# 默认保留用户远程沙箱，服务重启后可重连。
CLEANUP_SANDBOX_ON_SHUTDOWN=false

# ERP 与 MCP
JAVA_API_BASE_URL=http://localhost:8080/api
MCP_HOST=127.0.0.1
MCP_PORT=8000
MCP_PATH=/mcp
ERP_MCP_URL=http://127.0.0.1:8000/mcp

# 可选。不配置时不加载外部图表 MCP，基础 ERP 功能仍可初始化。
ANALYSIS_MCP_URL=

# Web
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
